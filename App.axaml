<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FH6Mod"
             xmlns:conv="using:FH6Mod.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="FH6Mod.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://FH6AllInOneTrainer/Styles/Theme.axaml" />
        <StyleInclude Source="avares://FH6AllInOneTrainer/Styles/NavRail.axaml" />
        <StyleInclude Source="avares://FH6AllInOneTrainer/Styles/Controls.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <conv:StatusLabelConverter       x:Key="StatusLabelConverter" />
            <conv:StatusBgConverter          x:Key="StatusBgConverter" />
            <conv:StatusFgConverter          x:Key="StatusFgConverter" />
            <conv:HexToBrushConverter        x:Key="HexToBrushConverter" />
            <conv:NotNullConverter           x:Key="NotNullConverter" />

            <!-- Vatsal: Updated visual styling and translucent dark glass surfaces; existing bindings remain unchanged. -->
            <!-- Brand accent -->
            <Color x:Key="AccentColor">#FF6A1F</Color>
            <Color x:Key="AccentColorHover">#FF8845</Color>
            <Color x:Key="AccentColorPressed">#E55400</Color>
            <Color x:Key="AccentColorMuted">#401E0F</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentBrushHover" Color="{StaticResource AccentColorHover}" />
            <SolidColorBrush x:Key="AccentBrushPressed" Color="{StaticResource AccentColorPressed}" />
            <SolidColorBrush x:Key="AccentBrushMuted" Color="{StaticResource AccentColorMuted}" />

            <!-- Surfaces: Translucent dark glass palette with solid fallback -->
            <Color x:Key="Surface0">#EB0B0E17</Color>
            <Color x:Key="Surface0Fallback">#0E1118</Color>
            <Color x:Key="Surface1">#59131926</Color>
            <Color x:Key="Surface1Hover">#731A2234</Color>
            <Color x:Key="Surface2">#661A2234</Color>
            <Color x:Key="Surface3">#80232E44</Color>
            <Color x:Key="SurfaceBorder">#1AFFFFFF</Color>
            <Color x:Key="SurfaceBorderSubtle">#0DFFFFFF</Color>
            <Color x:Key="SurfaceBorderHighlight">#2EFFFFFF</Color>
            <Color x:Key="SurfaceInput">#4D0A0D14</Color>
            <Color x:Key="SurfaceGlass">#400D111A</Color>

            <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}" />
            <SolidColorBrush x:Key="Surface0FallbackBrush" Color="{StaticResource Surface0Fallback}" />
            <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}" />
            <SolidColorBrush x:Key="Surface1HoverBrush" Color="{StaticResource Surface1Hover}" />
            <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />
            <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3}" />
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{StaticResource SurfaceBorder}" />
            <SolidColorBrush x:Key="SurfaceBorderSubtleBrush" Color="{StaticResource SurfaceBorderSubtle}" />
            <SolidColorBrush x:Key="SurfaceBorderHighlightBrush" Color="{StaticResource SurfaceBorderHighlight}" />
            <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInput}" />
            <SolidColorBrush x:Key="SurfaceGlassBrush" Color="{StaticResource SurfaceGlass}" />

            <!-- Clean typography contrast -->
            <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6" />
            <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />
            <SolidColorBrush x:Key="TextDim" Color="#64748B" />

            <!-- Muted status indicators -->
            <SolidColorBrush x:Key="StatusOk" Color="#34D399" />
            <SolidColorBrush x:Key="StatusWarn" Color="#FBBF24" />
            <SolidColorBrush x:Key="StatusErr" Color="#F87171" />

            <SolidColorBrush x:Key="StatusOkBg" Color="#1A34D399" />
            <SolidColorBrush x:Key="StatusWarnBg" Color="#1AFBBF24" />
            <SolidColorBrush x:Key="StatusErrBg" Color="#1AF87171" />

            <!-- Subtle accent tint -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#E6FF6A1F" Offset="0" />
                <GradientStop Color="#B3FF3D7A" Offset="1" />
            </LinearGradientBrush>

            <!-- Season colors: Muted, modern tones -->
            <SolidColorBrush x:Key="SeasonSpring" Color="#10B981" />
            <SolidColorBrush x:Key="SeasonSummer" Color="#F59E0B" />
            <SolidColorBrush x:Key="SeasonAutumn" Color="#F97316" />
            <SolidColorBrush x:Key="SeasonWinter" Color="#3B82F6" />

            <SolidColorBrush x:Key="SeasonSpringBg" Color="#1410B981" />
            <SolidColorBrush x:Key="SeasonSummerBg" Color="#14F59E0B" />
            <SolidColorBrush x:Key="SeasonAutumnBg" Color="#14F97316" />
            <SolidColorBrush x:Key="SeasonWinterBg" Color="#143B82F6" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
