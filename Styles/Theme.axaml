<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Vatsal: Configured native transparency hints with clean dark fallback, plus refined typography hierarchy -->
    <!-- Window chrome & backdrop -->
    <Style Selector="Window">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Inter, $Default" />
        <Setter Property="TransparencyLevelHint" Value="Mica, AcrylicBlur, Blur, Transparent, None" />
        <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource Surface0FallbackBrush}" />
    </Style>

    <!-- Default text -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Inter, $Default" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.2" />
    </Style>

    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.subtle">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Section label inside cards -->
    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Page title in header bar -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.2" />
    </Style>

    <!-- Page subtitle in header bar -->
    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- Application branding subtitle -->
    <Style Selector="TextBlock.app-subtitle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- Hint text (muted informative lines) -->
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="#8FA6CA" />
    </Style>

</Styles>
